APP_ENV=local
DATABASE_URL=postgresql+psycopg://victus:postgres@localhost:5432/victus_agent
BACKEND_API_URL=http://localhost:8000/v1
VICTUS_DOCKER_BACKEND_API_URL=http://host.docker.internal:8000/v1

LITELLM_PROXY_API_BASE=
VICTUS_DOCKER_LITELLM_PROXY_API_BASE=
LITELLM_PROXY_API_KEY=
LITELLM_KEY=
INTENT_EVAL_MODEL=litellm_proxy/gemini-flash-lite
VICTUS_CHAT_HTTP_HOST=0.0.0.0
VICTUS_CHAT_HTTP_PORT=8766
VICTUS_CHAT_DEBUG_ENABLED=false
VICTUS_MCP_HTTP_PORT=8765
POSTGRES_PORT=55432
VICTUS_API_TOKEN=

PHOENIX_TRACING_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6007
PHOENIX_BASE_URL=http://localhost:6007
PHOENIX_PROJECT_NAME=victus-local
PHOENIX_PORT=6007
OPENINFERENCE_HIDE_INPUTS=false
OPENINFERENCE_HIDE_OUTPUTS=false
OPENINFERENCE_HIDE_INPUT_MESSAGES=false
OPENINFERENCE_HIDE_OUTPUT_MESSAGES=false

# Required only for LangGraph Studio / LangSmith-backed graph visualization.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=victus-langgraph-local
